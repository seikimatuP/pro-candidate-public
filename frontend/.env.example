# ====================================
# 環境変数設定テンプレート
# ====================================
# このファイルを .env.local, .env.dev, .env.prod にコピーして使用してください
# 本番環境の機密情報は絶対にGitにコミットしないでください

# ====================================
# 環境設定
# ====================================
# 環境名: local | dev | prod
VITE_ENVIRONMENT=local

# アプリケーション名
VITE_APP_NAME=プロ野球志望届管理システム

# ====================================
# API設定
# ====================================
# APIベースURL（local環境では /api, dev/prod環境では実際のURL）
VITE_API_BASE_URL=/api

# APIタイムアウト（ミリ秒）
VITE_API_TIMEOUT=30000

# 本番データを使用するかどうか（local環境でのテスト用）
VITE_USE_PRODUCTION_DATA=false

# モックデータの遅延時間（ミリ秒）
VITE_MOCK_DELAY=500

# ====================================
# AWS Cognito設定（dev/prod環境のみ）
# ====================================
# 注意: これらの値は公開情報なので.envに含めても問題ありません
# ただし、シークレット情報は絶対に含めないでください

# AWSリージョン
VITE_AWS_REGION=ap-northeast-1

# CognitoユーザープールID（環境別に設定）
# dev: ap-northeast-1_devPoolId
# prod: ap-northeast-1_prodPoolId
VITE_COGNITO_USER_POOL_ID=

# CognitoクライアントID（環境別に設定）
# dev: devclientidxxxxxxxxxxxxxxx
# prod: prodclientidxxxxxxxxxxxxxx
VITE_COGNITO_CLIENT_ID=

# S3バケット名（デプロイ時に自動設定）
VITE_S3_BUCKET_NAME=

# ====================================
# 認証設定
# ====================================
# 認証が必要かどうか（local環境では false）
VITE_AUTH_REQUIRED=false

# ====================================
# フロントエンド設定
# ====================================
# フロントエンドURL（CORS設定などで使用）
VITE_FRONTEND_URL=http://localhost:5173

# ====================================
# デバッグ設定
# ====================================
# デバッグモード有効化
VITE_ENABLE_DEBUG=false

# デモ情報を表示するかどうか（本番環境では必ず false）
VITE_SHOW_DEMO_INFO=false

# デモパスワード（ローカル開発時のみ設定、本番環境では絶対に設定しない）
# VITE_DEMO_PASSWORD=

# ====================================
# オプション設定
# ====================================
# 分析機能の有効化
VITE_ENABLE_ANALYTICS=false

# エラーレポートの有効化
VITE_ENABLE_ERROR_REPORTING=false