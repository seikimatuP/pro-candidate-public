# npm configuration for better reliability in CI/CD environments

# Increase timeouts to handle slow network responses
fetch-timeout=300000
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-retries=3

# Set loglevel for better debugging
loglevel=verbose

# Optional: Use alternative registry if npm.org is slow
# registry=https://registry.npmmirror.com

# Disable progress bar for cleaner CI logs
progress=false

# Skip optional dependencies to speed up installation
omit=optional

# Force IPv4 to avoid IPv6 issues
prefer-online=true