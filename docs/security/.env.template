# セキュリティ機密情報テンプレート
# このファイルを .env.local にコピーして、実際の値を入力してください
# .env.local は .gitignore で保護されています

# AWS 認証情報
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-northeast-1
AWS_ACCOUNT_ID=your_aws_account_id_here

# Google OAuth 認証情報
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# AWS Cognito 認証情報 (Dev)
COGNITO_DEV_USER_POOL_ID=your_dev_user_pool_id_here
COGNITO_DEV_CLIENT_ID=your_dev_client_id_here
COGNITO_DEV_REGION=ap-northeast-1

# AWS Cognito 認証情報 (Prod)
COGNITO_PROD_USER_POOL_ID=your_prod_user_pool_id_here
COGNITO_PROD_CLIENT_ID=your_prod_client_id_here
COGNITO_PROD_REGION=ap-northeast-1

# AWS SES 設定
SES_ENDPOINT=email.ap-northeast-1.amazonaws.com
SES_FROM_EMAIL=your_verified_email@example.com
SES_REGION=ap-northeast-1

# DynamoDB 設定
DYNAMODB_TABLE_NAME=pro-candidate-prod
DYNAMODB_REGION=ap-northeast-1

# GitHub 認証
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=seikimatuP/pro_candidate

# データベース接続情報（該当する場合）
DB_HOST=your_db_host_here
DB_PORT=5432
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here

# その他の機密情報
API_KEY_EXTERNAL_SERVICE=your_api_key_here
API_SECRET_EXTERNAL_SERVICE=your_api_secret_here
