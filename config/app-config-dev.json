{
  "scraping": {
    "timeout": 30000,
    "retryCount": 3,
    "userAgent": "Mozilla/5.0 (compatible; DataScraper/1.0; AWS Lambda)",
    "headers": {
      "Accept": "text/html,application/xhtml+xml",
      "Accept-Language": "ja,en-US;q=0.7"
    },
    "rateLimit": {
      "enabled": true,
      "delayMs": 1000,
      "maxConcurrency": 3
    }
  },
  "processing": {
    "batchSize": 100,
    "maxConcurrency": 5,
    "validation": {
      "strictMode": true,
      "skipInvalidRecords": false
    },
    "dataEnrichment": {
      "enabled": true,
      "geocoding": false
    }
  },
  "storage": {
    "s3": {
      "multipartUpload": true,
      "encryption": true,
      "compressionLevel": 6
    },
    "backup": {
      "enabled": true,
      "retentionDays": 30,
      "crossRegion": false
    }
  },
  "notifications": {
    "enabled": true,
    "channels": ["email", "cloudwatch"],
    "alertThresholds": {
      "errorRate": 0.05,
      "maxDuration": 300000,
      "memoryUsage": 0.8
    },
    "emailSettings": {
      "recipients": ["admin@pro-candidate.com"],
      "template": "default"
    }
  },
  "monitoring": {
    "xray": {
      "enabled": true,
      "samplingRate": 0.1
    },
    "metrics": {
      "customMetrics": true,
      "detailedLogging": true
    }
  },
  "features": {
    "experimental": {
      "parallelProcessing": true,
      "mlEnhancement": false,
      "advancedCaching": true
    }
  }
}