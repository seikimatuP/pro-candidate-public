{
  "name": "pro_candidate",
  "version": "1.0.0",
  "description": "",
  "main": "src/main.ts",
  "scripts": {
    "test": "jest",
    "format": "node_modules/.bin/eslint src --fix && node_modules/.bin/prettier --write src",
    "lint": "cd frontend && npm run lint",
    "lint:root": "eslint . --config eslint.config.mjs",
    "lint:lambda": "cd pro-candidate-aws/lambda && eslint . --config eslint.config.mjs",
    "lint:all": "npm run lint:root && npm run lint:lambda && npm run lint",
    "lint:fix": "cd frontend && npm run lint -- --fix",
    "analyze": "node static-analysis/analyze.js",
    "sonar": "jest --coverage --config=jest.config.js ; node scripts/generate-sonar-test-report.js ; node scripts/run-sonar.js",
    "check-quality": "npm run lint && npm run test:coverage && npm run sonar",
    "build": "node build.js",
    "test:silent": "jest --silent",
    "watch": "webpack --progress --watch",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "prepush": "npm test",
    "test:clear": "jest --clearCache",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit --testPathIgnorePatterns=tests/integration",
    "test:integration": "jest tests/integration",
    "test:source": "jest --coverage --collectCoverageFrom='src/**/*.{js,ts}'",
    "test:snapshot": "jest tests/snapshot",
    "test:snapshot:update": "jest tests/snapshot --updateSnapshot",
    "test:e2e": "node scripts/run_e2e_tests.js",
    "deploy:aws:dev": "cd pro-candidate-aws && npm run deploy:dev",
    "deploy:aws:prod": "cd pro-candidate-aws && npm run deploy:prod",
    "aws:diff": "cd pro-candidate-aws && npm run diff",
    "aws:synth": "cd pro-candidate-aws && npm run synth",
    "generate-report": "node scripts/generate_analysis_report.js",
    "quality-check": "npm run generate-report && node scripts/quality-gate-check.js",
    "pre-deploy-check": "node scripts/deploy-checks.js",
    "analyze:full": "npm run lint && npm run test:coverage && npm run analyze && npm run sonar",
    "quality-report": "node scripts/generate_analysis_report.js",
    "deploy:safe": "npm run pre-deploy-check && npm run deploy",
    "update-snapshots": "jest --updateSnapshot",
    "test:all": "npm run test:e2e:dev",
    "ci-check": "npm run lint -- --max-warnings 0 && npx tsc --noEmit --strict && npm run test:e2e:dev",
    "sonar:with-errors": "node scripts/run-sonar-with-errors.js",
    "test:fast": "jest --config=jest.config.optimized.js",
    "test:parallel": "jest --config=jest.config.optimized.js --maxWorkers=4",
    "test:unit:fast": "jest --config=jest.config.optimized.js --selectProjects=unit",
    "perf": "node scripts/performance-monitor.js",
    "perf:report": "node scripts/performance-monitor.js report",
    "perf:test": "node scripts/performance-monitor.js test",
    "perf:build": "node scripts/performance-monitor.js build",
    "build:optimized": "node build.js --optimize",
    "memory-test": "node scripts/memory-test.js",
    "analyze:perf": "npm run perf && npm run perf:report",
    "analyze:visual": "node static-analysis/analyze.js && node static-analysis/visual-enhancer.js",
    "enhance-dashboard": "node static-analysis/visual-enhancer.js",
    "docs": "typedoc --options typedoc.json",
    "docs:watch": "typedoc --options typedoc.json --watch",
    "docs:serve": "npx serve docs/api",
    "docs:full": "npm run docs && npm run docs:serve",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:e2e:docker": "docker build -f Dockerfile.playwright -t playwright-tests . && docker run --rm -v \"$(pwd)/test-results:/app/test-results\" -v \"$(pwd)/playwright-report:/app/playwright-report\" playwright-tests",
    "test:e2e:local": "scripts/run-e2e-test.sh local",
    "test:e2e:dev": "scripts/run-e2e-test.sh dev",
    "test:e2e:prod": "scripts/run-e2e-test.sh prod",
    "test:e2e:ci": "npx playwright test --config=playwright.config.ci.ts",
    "test:e2e:api": "npx playwright test tests/e2e/specs/api.spec.ts --config=playwright.config.ci.ts",
    "test:e2e:api:dev": "scripts/run-e2e-test.sh dev --api-only",
    "test:e2e:api:prod": "scripts/run-e2e-test.sh prod --api-only",
    "test:e2e:dev:headed": "scripts/run-e2e-test.sh dev --headed",
    "test:e2e:prod:headed": "scripts/run-e2e-test.sh prod --headed",
    "test:e2e:dev:debug": "scripts/run-e2e-test.sh dev --debug",
    "test:e2e:prod:debug": "scripts/run-e2e-test.sh prod --debug",
    "test:e2e:optimized": "npx playwright test --config=playwright.config.optimized.ts",
    "test:e2e:dev:optimized": "scripts/run-e2e-test.sh dev --optimized",
    "test:e2e:prod:optimized": "scripts/run-e2e-test.sh prod --optimized",
    "test:e2e:network-stable": "npx playwright test tests/e2e/specs/dashboard-optimized.spec.ts --config=playwright.config.optimized.ts",
    "e2e:report:local": "npx playwright show-report playwright-report/local",
    "e2e:report:dev": "npx playwright show-report playwright-report/dev",
    "e2e:report:prod": "npx playwright show-report playwright-report/prod",
    "e2e:server": "node scripts/serve-e2e-reports.js",
    "e2e:clean": "rm -rf playwright-report/ test-results/",
    "test:performance": "node tests/performance/load-test.js",
    "test:security": "node tests/security/security-scan.js",
    "test:phase5": "npm run test:playwright && npm run test:performance && npm run test:security",
    "test:aws:coverage": "jest --config=jest.config.aws.js --coverage",
    "test:comprehensive": "npm run test:aws && npm run test:e2e:api && npm run test:performance && npm run test:security",
    "health-check": "npm run test:e2e:api",
    "monitor:aws": "node scripts/aws-health-monitor.js",
    "monitor:aws:continuous": "node scripts/aws-health-monitor.js --continuous",
    "mcp:start": "node scripts/mcp-http-server.js start",
    "mcp:stop": "node scripts/mcp-http-server.js stop",
    "mcp:restart": "node scripts/mcp-http-server.js restart",
    "mcp:health": "node scripts/mcp-http-server.js health",
    "mcp:client": "node scripts/claude-code-mcp-client.js",
    "mcp:test": "node scripts/claude-code-mcp-client.js test",
    "prepare": "test -d .git && command -v husky >/dev/null 2>&1 && husky || echo 'Skipping husky setup (CI or missing .git)'"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-report.json",
    "indent": 2
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@aws-amplify/auth": "^6.16.0",
    "@aws-sdk/client-cloudwatch": "^3.922.0",
    "@aws-sdk/client-secrets-manager": "^3.913.0",
    "@aws-sdk/client-ses": "^3.917.0",
    "@aws-sdk/client-sns": "^3.917.0",
    "@aws-sdk/client-ssm": "^3.917.0",
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@playwright/test": "^1.56.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.0",
    "autocannon": "^8.0.0",
    "aws-amplify": "^6.15.7",
    "aws-cdk-lib": "^2.221.0",
    "aws-sdk-mock": "^6.2.1",
    "babel-jest": "^30.2.0",
    "babel-loader": "^10.0.0",
    "chalk": "^5.6.2",
    "copy-webpack-plugin": "^13.0.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "express": "^5.1.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "jmeter": "^0.0.1",
    "playwright": "^1.56.0",
    "prettier": "^3.6.2",
    "serve": "^14.2.5",
    "sonar-scanner": "^3.1.0",
    "sonarqube-scanner": "^4.3.2",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "typedoc": "^0.28.14",
    "typedoc-plugin-not-exported": "^0.1.6",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.917.0",
    "@google/generative-ai": "^0.24.1",
    "@types/uuid": "^11.0.0",
    "chart.js": "^3.9.1",
    "cheerio": "^1.1.2",
    "eventsource": "^3.0.7",
    "jsdom": "^27.0.1",
    "node-fetch": "^2.7.0",
    "uuid": "^13.0.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "prettier"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error",
      "no-unused-vars": "warn"
    }
  }
}
