{
  "name": "pro_candidate",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "vitest run",
    "format": "node_modules/.bin/eslint src --fix && node_modules/.bin/prettier --write src",
    "lint": "pnpm --filter frontend lint",
    "lint:root": "eslint . --config eslint.config.mjs",
    "lint:lambda": "cd pro-candidate-aws/lambda && eslint . --config eslint.config.mjs",
    "lint:all": "pnpm run lint:root && pnpm run lint:lambda && pnpm run lint",
    "lint:fix": "pnpm --filter frontend lint -- --fix",
    "jscpd": "jscpd .",
    "knip": "knip",
    "analyze": "node static-analysis/analyze.js",
    "check-quality": "pnpm run lint && pnpm run test:coverage",
    "build": "pnpm --filter frontend build",
    "test:silent": "vitest run --silent",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "prepush": "pnpm test",
    "test:clear": "rm -rf node_modules/.vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:source": "vitest run --coverage --include='src/**/*.{js,ts}'",
    "test:snapshot": "vitest run --update",
    "test:snapshot:update": "vitest run --update",
    "deploy:aws:dev": "pnpm --filter pro-candidate-aws deploy:dev",
    "deploy:aws:prod": "pnpm --filter pro-candidate-aws deploy:prod",
    "aws:diff": "pnpm --filter pro-candidate-aws diff",
    "aws:synth": "pnpm --filter pro-candidate-aws synth",
    "quality-check": "node scripts/quality-gate-check.js",
    "pre-deploy-check": "node scripts/pre-deploy-check.js",
    "analyze:full": "pnpm run lint && pnpm run test:coverage && pnpm run analyze",
    "update-snapshots": "vitest run --update",
    "test:all": "pnpm run test:e2e:dev",
    "ci-check": "pnpm run lint -- --max-warnings 0 && pnpm exec tsc --noEmit --strict && pnpm run test:e2e:dev",
    "test:fast": "vitest run --pool=threads",
    "test:parallel": "vitest run --pool=threads --poolOptions.threads.maxThreads=4",
    "test:unit:fast": "vitest run tests/unit --pool=threads",
    "analyze:visual": "node static-analysis/analyze.js && node static-analysis/visual-enhancer.js",
    "enhance-dashboard": "node static-analysis/visual-enhancer.js",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:e2e:local": "doppler run --project pro-candidate --config dev_local -- scripts/run-e2e-test.sh local",
    "test:e2e:dev": "doppler run --project pro-candidate --config e2e_dev -- scripts/run-e2e-test.sh dev",
    "test:e2e:prod": "doppler run --project pro-candidate --config e2e_prod -- scripts/run-e2e-test.sh prod",
    "test:e2e:ci": "pnpm exec playwright test --config=playwright.config.ci.ts",
    "test:e2e:api": "pnpm exec playwright test tests/e2e/specs/api.spec.ts --config=playwright.config.ci.ts",
    "test:e2e:api:dev": "doppler run --project pro-candidate --config e2e_dev -- scripts/run-e2e-test.sh dev --api-only",
    "test:e2e:api:prod": "doppler run --project pro-candidate --config e2e_prod -- scripts/run-e2e-test.sh prod --api-only",
    "test:e2e:dev:headed": "doppler run --project pro-candidate --config e2e_dev -- scripts/run-e2e-test.sh dev --headed",
    "test:e2e:prod:headed": "doppler run --project pro-candidate --config e2e_prod -- scripts/run-e2e-test.sh prod --headed",
    "test:e2e:dev:debug": "doppler run --project pro-candidate --config e2e_dev -- scripts/run-e2e-test.sh dev --debug",
    "test:e2e:prod:debug": "doppler run --project pro-candidate --config e2e_prod -- scripts/run-e2e-test.sh prod --debug",
    "e2e:report:local": "pnpm exec playwright show-report playwright-report/local",
    "e2e:report:dev": "pnpm exec playwright show-report playwright-report/dev",
    "e2e:report:prod": "pnpm exec playwright show-report playwright-report/prod",
    "e2e:server": "node scripts/serve-e2e-reports.js",
    "e2e:clean": "rm -rf playwright-report/ test-results/",
    "test:performance": "node tests/performance/load-test.js",
    "test:security": "node tests/security/security-scan.js",
    "test:phase5": "pnpm run test:playwright && pnpm run test:performance && pnpm run test:security",
    "test:aws:coverage": "vitest run tests/aws --coverage",
    "test:comprehensive": "pnpm run test:aws:coverage && pnpm run test:e2e:api && pnpm run test:performance && pnpm run test:security",
    "health-check": "pnpm run test:e2e:api",
    "monitor:aws": "node scripts/aws-health-monitor.js",
    "monitor:aws:continuous": "node scripts/aws-health-monitor.js --continuous",
    "prepare": "test -d .git && command -v husky >/dev/null 2>&1 && husky || echo 'Skipping husky setup (CI or missing .git)'"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.15.0",
      "follow-redirects": ">=1.16.0",
      "node-forge": ">=1.4.0",
      "flatted": ">=3.4.2",
      "serialize-javascript": ">=7.0.5",
      "lodash": ">=4.18.0",
      "qs": ">=6.14.2",
      "path-to-regexp": ">=8.4.0",
      "fast-xml-parser": ">=5.5.7",
      "undici": ">=8.9.0",
      "jsdom>undici": ">=7.29.0 <8.0.0",
      "eslint>minimatch": ">=3.1.4",
      "eslint-plugin-import>minimatch": ">=3.1.4",
      "filelist>minimatch": ">=5.1.8",
      "glob>minimatch": ">=9.0.7",
      "micromatch>picomatch": ">=2.3.2",
      "@rollup/pluginutils>picomatch": ">=2.3.2",
      "anymatch>picomatch": ">=2.3.2",
      "vitest>picomatch": ">=2.3.2",
      "tinyglobby>picomatch": ">=4.0.4",
      "ts-declaration-location>picomatch": ">=4.0.4",
      "lint-staged>picomatch": ">=4.0.4",
      "@eslint/config-array>minimatch": ">=3.1.4",
      "eslint>ajv": "^6.14.0",
      "@eslint/eslintrc>ajv": "^6.14.0",
      "schema-utils>ajv": ">=8.18.0",
      "cosmiconfig>yaml": ">=1.10.3",
      "lint-staged>yaml": ">=2.8.3",
      "typedoc>yaml": ">=2.8.3",
      "ts-node>diff": ">=4.0.4",
      "sinon>diff": ">=5.2.2",
      "vite>rollup": ">=4.59.0",
      "@eslint/eslintrc>minimatch": ">=3.1.4",
      "brace-expansion": ">=5.0.5",
      "hyperid>uuid": ">=11.1.1",
      "@babel/core": ">=7.29.7",
      "@eslint/eslintrc>js-yaml": ">=4.3.1 <5",
      "@istanbuljs/load-nyc-config>js-yaml": ">=3.15.1 <4",
      "webpack-cli>js-yaml": ">=4.3.1 <5"
    }
  },
  "packageManager": "pnpm@10.25.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": "prettier --check"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@aws-amplify/auth": "^6.20.0",
    "@aws-sdk/client-cloudwatch": "^3.1111.0",
    "@aws-sdk/client-lambda": "^3.1111.0",
    "@aws-sdk/client-secrets-manager": "^3.1111.0",
    "@aws-sdk/client-ses": "^3.1111.0",
    "@aws-sdk/client-sns": "^3.1111.0",
    "@aws-sdk/client-ssm": "^3.1111.0",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autocannon": "^8.0.0",
    "aws-amplify": "^6.20.0",
    "aws-cdk-lib": "^2.265.0",
    "aws-sdk-client-mock": "^4.1.0",
    "babel-loader": "^10.1.1",
    "chalk": "^6.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "jmeter": "^0.0.1",
    "jscpd": "^5.0.15",
    "jsdom": "^29.1.1",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "sonar-scanner": "^3.1.0",
    "sonarqube-scanner": "^5.0.0",
    "ts-loader": "^9.6.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-not-exported": "^0.1.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@google/generative-ai": "^0.24.1",
    "@rollup/rollup-linux-x64-gnu": "^4.62.4",
    "@types/uuid": "^11.0.0",
    "chart.js": "^3.9.1",
    "cheerio": "^1.2.0",
    "eventsource": "^5.1.0",
    "jsdom": "^29.1.1",
    "node-fetch": "^2.7.0",
    "uuid": "^14.0.1"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "prettier"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error",
      "no-unused-vars": "warn"
    }
  }
}
